# Copy this file to `.env` and replace the placeholder values.
# Never commit the real `.env` file.

APP_NAME=Kamareddy Wedding Marketplace API
ENVIRONMENT=development

# Development database
DATABASE_URL=postgresql+psycopg://wedding_user:CHANGE_ME@localhost:5432/wedding_marketplace

# Separate database used ONLY by pytest. Its name must end with "_test".
TEST_DATABASE_URL=postgresql+psycopg://wedding_user:CHANGE_ME@localhost:5432/wedding_marketplace_test

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Signs access tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep secret; changing it logs everyone out.
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING_OF_AT_LEAST_32_CHARS
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Set to true when serving over HTTPS.
COOKIE_SECURE=false

# Base URL browsers use to reach this API (used to build portfolio image URLs).
PUBLIC_BASE_URL=http://localhost:8000
# Portfolio upload limits
MAX_UPLOAD_MB=5
MAX_PORTFOLIO_ITEMS=30
